---
/**
 * 隨想流（对应旧站 app/inspiration/page.tsx）
 * 「一心净土」按小节拆分的条目，按文章日期倒序 + 文内倒序
 * 条目头与旧站 cra 版一致：标题与日期同行（parseTime 默认格式「yyyy年MM月dd日」）
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const entries = (await getCollection('inspiration')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || b.data.order - a.data.order,
);

const items = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout title={`隨想 - 晴晝夢`}>
  <div class="page px-0 inspiration">
    <!-- 悬停滑动遮罩：class 与旧站一致；初始 height:0 使脚本未执行时不可见（见页尾脚本） -->
    <div
      class="mask pointer-events-none absolute left-0 top-0 w-full transform rounded transition-all duration-300 ease-in-out"
      data-inspiration-mask
      style="height: 0px; transform: translateY(0px)"></div>
    <div class="relative space-y-4 overflow-x-clip" data-inspiration-list>
      {
        items.map(({ entry, Content }) => (
          <article class="cursor-pointer p-4" data-aos="fade-left">
            <div class="flex text-xl italic">
              <h2 class="mr-2 mb-2">{entry.data.title}</h2>
            </div>
            <div class="prose max-w-full">
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  import { moveListMask } from '../utils/listMask';

  /**
   * 隨想流悬停滑动遮罩
   *
   * 对应旧站 app/inspiration/page.tsx 的 maskRef / calcMaskPos / handleMask / handleScroll。
   * 这里只写内联的 height / transform，滑动交给 CSS 的
   * `transition-all duration-300 ease-in-out` —— 时长与缓动曲线因此天然与旧站相同。
   *
   * 另比旧站多两处稳健性处理（不改变可见行为）：
   *  - ResizeObserver：条目因图片/字体延迟加载变高时重新对齐（旧站只在 scroll 时重算）
   *  - 初始化前先解绑上一轮监听：换页后 DOM 已替换，挂在旧节点上的监听会累积
   */
  const MASK_SELECTOR = '[data-inspiration-mask]';
  const LIST_SELECTOR = '[data-inspiration-list]';

  let cleanup: (() => void) | null = null;

  const setup = () => {
    cleanup?.();
    cleanup = null;

    const mask = document.querySelector<HTMLElement>(MASK_SELECTOR);
    const list = document.querySelector<HTMLElement>(LIST_SELECTOR);
    if (!mask || !list) return;

    const items = () => [...list.querySelectorAll<HTMLElement>(':scope > article')];

    // 对齐公式与早退守卫都在 utils/listMask（与首页文章列表共用）。
    // 2026-10-31 起不再现读 .page 的 paddingTop —— 那个公式只在「列表容器之上
    // 没有流内元素」时成立，统一用 list.offsetTop 后与 PostList 口径一致。
    const moveTo = (item: HTMLElement) => moveListMask(mask, item, list);

    let current = items()[0] ?? null;
    if (current) moveTo(current);

    const onOver = (event: Event) => {
      const target = (event.target as HTMLElement | null)?.closest<HTMLElement>('article');
      if (!target || !list.contains(target)) return;
      current = target;
      moveTo(target);
    };
    list.addEventListener('mouseover', onOver);

    const observer = new ResizeObserver(() => {
      if (current) moveTo(current);
    });
    observer.observe(list);

    cleanup = () => {
      list.removeEventListener('mouseover', onOver);
      observer.disconnect();
    };
  };

  document.addEventListener('astro:page-load', setup);
</script>
