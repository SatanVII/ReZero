---
/**
 * 首页（对应旧站 app/page.tsx）：渲染「关于」分类的最新文章 + 评论
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Comment from '@/components/Comment.astro';

const home = (
  await getCollection('post', ({ data }) => data.category === '关于')
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const { Content } = await render(home);
---

<BaseLayout>
  <div class="page prose max-w-full">
    <article>
      <Content />
    </article>
    <Comment term="空空" />
  </div>
</BaseLayout>
