---
/**
 * 归档子视图 · 分类（/archives/category/<分类>）
 *
 * 构建期按 frontmatter 的 category 聚合。
 * 「关于」「随想」不生成分类页 —— 它们分别由 /about 自述页与 /inspiration 隨想流独占
 * （排除项见 src/utils/content.ts，与首页 index.astro 共用同一份）。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchiveView from '@/components/ArchiveView.astro';
import { groupArchiveEntries } from '@/utils/content';

export async function getStaticPaths() {
  const all = await getCollection('post');
  // 单值维度：分类是单一字段
  const grouped = groupArchiveEntries(all, (entry) => entry.data.category);

  return [...grouped.entries()].map(([category, entries]) => ({
    params: { category },
    props: { category, entries },
  }));
}

const { category, entries } = Astro.props;
---

<BaseLayout
  title={`分类：${category} - 晴晝夢`}
  description={`分类「${category}」下的全部文章，共 ${entries.length} 篇。`}
  keywords={category}
>
  <ArchiveView entries={entries} kind="分类" label={category} />
</BaseLayout>
