---
/**
 * 归档子视图 · 时间线（/archives/year/<年份>）
 *
 * 构建期按 frontmatter 的 date 取年份聚合；跨年后自动出现新年份页面。
 * 粒度按用户 2026-10-06 决定：**仅到年**，不做月份下钻。
 * 「关于」「随想」两类文章在**三个维度一律排除**（见 src/utils/content.ts）。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchiveView from '@/components/ArchiveView.astro';
import { groupArchiveEntries } from '@/utils/content';

export async function getStaticPaths() {
  const all = await getCollection('post');
  // 单值维度：按 frontmatter 日期取年份（仅到年，不做月份下钻）
  const grouped = groupArchiveEntries(all, (entry) => String(entry.data.date.getFullYear()));

  return [...grouped.entries()].map(([year, entries]) => ({
    params: { year },
    props: { year, entries },
  }));
}

const { year, entries } = Astro.props;
---

<BaseLayout
  title={`${year} 年 - 晴晝夢`}
  description={`${year} 年的全部文章，共 ${entries.length} 篇。`}
  keywords={year}
>
  <ArchiveView entries={entries} kind="时间线" label={year} />
</BaseLayout>
