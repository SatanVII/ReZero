---
/** 404 页（旧站使用 Next 默认 404，Astro 按官方约定提供 src/pages/404.astro） */
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到 - 抹茶">
  <div class="page flex flex-col items-center justify-center gap-6 text-center">
    <h2 class="text-6xl italic">404</h2>
    <p>云深不知处，页面未找到。</p>
    <a href="/" class="underline underline-offset-4">回到首页</a>
  </div>
</BaseLayout>
