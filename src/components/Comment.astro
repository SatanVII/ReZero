---
/**
 * giscus 评论（对应旧站 components/Comment 的 React 方案，改为官方 script 嵌入）
 * mapping=specific 按传入的 term 区分评论区；主题联动 giscus 主题 CSS
 */
interface Props {
  term: string;
}

const { term } = Astro.props;
---

<div class="mt-16" data-giscus data-term={term}></div>

<script>
  // 与旧站 components/Comment 的配置一致（仓库/ID 已替换为 SatanVII/Comment）
  const GISCUS_CONFIG = {
    repo: 'SatanVII/Comment',
    repoId: 'R_kgDOUdgH8Q',
    category: 'Announcements',
    categoryId: 'DIC_kwDOUdgH8c4DFvXO',
  };

  // 主题 CSS 版本号：改 public/assets/styles/*.css 后手动 bump，用于破坏缓存
  const THEME_V = '2026092301';

  // ---------------------------------------------------------------------------
  // 主题注入方式说明（重要）：
  // giscus 运行在 https://giscus.app 的 iframe 里。浏览器把 http://localhost 视为
  // 私有网络地址，公网(https)上下文加载它会被拦截（样式表 ERR_ABORTED、字体
  // MissingAllowOriginHeader），因此主题 URL 不能直接指向本站——这正是之前
  // 评论区一直白屏的根因。
  // 解决：在页面侧（同源、不受限）把主题 CSS + comment.css 打包成自包含的
  // data:text/css URL 传给 giscus。data: URL 已验证可在 giscus iframe 内生效。
  // 任何部署域名下行为一致，不依赖宿主 CORS 头。
  // ---------------------------------------------------------------------------

  const stripImports = (css: string) => css.replace(/@import\s+url\([^)]*\)\s*;?/g, '');
  const toDataUrl = (css: string) =>
    'data:text/css;charset=utf-8,' + encodeURIComponent(css);

  async function fetchText(url: string): Promise<string> {
    const res = await fetch(url);
    if (!res.ok) throw new Error(`${res.status} ${url}`);
    return res.text();
  }

  async function fetchBuffer(url: string): Promise<Uint8Array> {
    const res = await fetch(url);
    if (!res.ok) throw new Error(`${res.status} ${url}`);
    return new Uint8Array(await res.arrayBuffer());
  }

  const toBase64 = (bytes: Uint8Array): string => {
    let bin = '';
    for (let i = 0; i < bytes.length; i += 0x8000) {
      bin += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
    }
    return btoa(bin);
  };

  // ---------------------------------------------------------------------------
  // 评论字体：与文章正文一致（霞鹜文楷 LXGW WenKai Regular 400，
  // lxgw-wenkai-webfont 包同源自托管分片，位置
  // public/assets/styles/fonts/lxgw-wenkai/；2026-09-17 由 Noto Serif SC 更换）。
  // iframe 内无法请求本站字体（PNA/CORS 拦截），故在页面侧把 woff2 分片抓下来
  // base64 内联进主题 CSS，再打包进 data: URL。unicode-range 分片下浏览器只
  // 真正加载用到的字形分片，注册上百个 face 无额外网络成本。
  // ---------------------------------------------------------------------------
  const FONT_CSS_URL = `/assets/styles/fonts/lxgw-wenkai.css?v=${THEME_V}`;
  let fontCssPromise: Promise<string> | null = null;

  function buildFontCss(): Promise<string> {
    fontCssPromise ??= (async () => {
      // 以字体 CSS 自身 URL 为基准解析相对路径（正则只抓 ./ 开头的 woff2 引用）
      const fontCssUrl = new URL(FONT_CSS_URL, location.origin).href;
      let css = await fetchText(FONT_CSS_URL);
      const refs = [
        ...new Set(
          [...css.matchAll(/url\((\.\/[^)]+\.woff2)\)/g)].map((m) => m[1]),
        ),
      ];
      await Promise.all(
        refs.map(async (rel) => {
          const abs = new URL(rel, fontCssUrl).href;
          const bytes = await fetchBuffer(abs);
          // wOF2 魔数校验，防止 404 的 HTML 被误当字体内联
          if (
            !(bytes[0] === 0x77 && bytes[1] === 0x4f && bytes[2] === 0x46 && bytes[3] === 0x32)
          ) {
            throw new Error(`woff2 魔数校验失败: ${abs}`);
          }
          css = css.split(rel).join(`data:font/woff2;base64,${toBase64(bytes)}`);
        }),
      );
      console.log(`[giscus] 评论字体内联完成：${refs.length} 片 (LXGW WenKai Regular)`);
      return css;
    })().catch((err) => {
      // 字体失败不阻塞配色：返回空串即回退 sans-serif
      console.error('[giscus] 构建评论字体失败，回退 sans-serif：', err);
      return '';
    });
    return fontCssPromise;
  }

  // 完整主题：字体（与文章一致）+ comment.css（基础变量）+ 主题覆盖
  const fullThemeCache = new Map<string, Promise<string>>();

  function buildFullTheme(theme: string): Promise<string> {
    const key = theme.toLowerCase();
    if (!fullThemeCache.has(key)) {
      fullThemeCache.set(
        key,
        (async () => {
          const [themeCss, commentCss, fontCss] = await Promise.all([
            fetchText(`/assets/styles/${key}.css?v=${THEME_V}`),
            fetchText(`/assets/styles/comment.css?v=${THEME_V}`),
            buildFontCss(),
          ]);
          // 顺序：字体声明在前，comment.css 次之，主题覆盖在后（与原站级联一致）
          const merged =
            (fontCss ? fontCss + '\n' : '') +
            stripImports(commentCss) +
            '\n' +
            stripImports(themeCss);
          return toDataUrl(merged);
        })().catch((err) => {
          console.error('[giscus] 构建完整主题失败，回退内置 light：', err);
          return Promise.resolve('light');
        }),
      );
    }
    return fullThemeCache.get(key)!;
  }

  // 引导主题：仅配色（去掉注释与空白以压体积），随 widget URL 传入；
  // 字体由 iframe 就绪后的 postMessage 升级补齐
  async function buildBootstrapTheme(theme: string): Promise<string> {
    const key = theme.toLowerCase();
    try {
      const [themeCss, commentCss] = await Promise.all([
        fetchText(`/assets/styles/${key}.css?v=${THEME_V}`),
        fetchText(`/assets/styles/comment.css?v=${THEME_V}`),
      ]);
      const minify = (css: string) =>
        stripImports(css)
          .replace(/\/\*[\s\S]*?\*\//g, '')
          .replace(/\n\s*/g, '');
      return toDataUrl(minify(commentCss) + minify(themeCss));
    } catch (err) {
      console.error('[giscus] 构建引导主题失败，回退内置 light：', err);
      return 'light';
    }
  }

  const postTheme = (theme: string) => {
    document.querySelectorAll<HTMLIFrameElement>('.giscus-frame').forEach((frame) => {
      frame.contentWindow?.postMessage(
        { giscus: { setConfig: { theme } } },
        'https://giscus.app',
      );
    });
  };

  // 当前期望的完整主题（data URL）；iframe 就绪探测与主题切换共用，
  // 每次重试都取"当下"的主题，避免慢就绪的旧主题覆盖新切换
  let currentThemeName = document.documentElement.dataset.theme ?? 'Hutao';

  // iframe 就绪后把完整主题（含字体）推过去；giscus 初始化存在竞态，故多次重试
  function upgradeWhenReady() {
    let tries = 0;
    const timer = setInterval(() => {
      tries++;
      const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      if (frame) postCurrentFullTheme();
      if ((frame && tries > 4) || tries > 16) clearInterval(timer);
    }, 800);
  }

  function postCurrentFullTheme() {
    buildFullTheme(currentThemeName).then(postTheme);
  }

  const mount = async (container: HTMLElement) => {
    if (container.querySelector('iframe')) return;
    currentThemeName = document.documentElement.dataset.theme ?? 'Hutao';
    const theme = currentThemeName;
    // 完整主题（含字体分片内联）预构建：与 giscus 脚本网络加载、引导版构建并行。
    // 此前要等 iframe 就绪探测循环首次触发才开始抓 97 个分片，字体应用总是
    // "慢半拍"；现在构建提前启动，探测循环推送时直接命中缓存，零等待。
    const fullThemePromise = buildFullTheme(theme);
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.crossOrigin = 'anonymous';
    script.async = true;
    script.dataset.repo = GISCUS_CONFIG.repo;
    script.dataset.repoId = GISCUS_CONFIG.repoId;
    script.dataset.category = GISCUS_CONFIG.category;
    script.dataset.categoryId = GISCUS_CONFIG.categoryId;
    script.dataset.mapping = 'specific';
    script.dataset.term = container.getAttribute('data-term') ?? '';
    script.dataset.reactionsEnabled = '0';
    script.dataset.emitMetadata = '0';
    script.dataset.inputPosition = 'top';
    // 主题挂在 <html data-theme> 上（构建期 CSS 提供配色），首屏由 head 内联脚本写好
    script.dataset.theme = await buildBootstrapTheme(theme);
    script.dataset.lang = 'zh-CN';
    script.dataset.loading = 'lazy';
    container.appendChild(script);
    // 防止预构建 Promise 未被探测循环消费时静默失败（缓存已建，后续调用复用）
    void fullThemePromise;
    upgradeWhenReady();
  };

  // ---------------------------------------------------------------------------
  // 懒挂载（2026-09-25）：换页瞬间不挂 giscus，等「评论区可见 + 用户有真实输入」才挂。
  //
  // 原因：客户端换页会让 Chromium 把显示光标锁存成默认箭头（换页时 hover 链塌缩，
  // 而 Chromium 的光标只在鼠标事件时重算），通常几十毫秒内随下一次重算自愈、不可
  // 感知；但 giscus 的 script/iframe 注入会在换页后 ~450ms 再次触发同样的锁存，
  // 把箭头拉长到肉眼可见的 ~1s（真实 OS 级点击 + GetCursorInfo 实测：仅挂载评论的
  // 页面 書閣/友鄰/自述 出现，文章/隨想/項目 不出现）。
  //
  // 条件设计：评论区进入视口（IntersectionObserver）**且** 用户有真实输入
  // （pointermove / wheel / keydown，信任事件才计入）——指针在图标上静止不动就
  // 永不注入，手型得以保持；一旦用户移动鼠标，注入发生在连续的输入事件流里，
  // 即使有瞬时重置也会被下一个移动事件立即纠正，不可感知。评论区在页面底部，
  // 此策略对功能零影响，且每次换页省去 97 个字体分片请求。
  // ---------------------------------------------------------------------------
  const visibleContainers = new Set<HTMLElement>();
  let commentObserver: IntersectionObserver | null = null;
  let hasInputSinceLoad = false;

  const flushVisibleContainers = () => {
    if (!hasInputSinceLoad) return;
    for (const el of visibleContainers) {
      commentObserver?.unobserve(el);
      void mount(el);
    }
    visibleContainers.clear();
  };
  const markRealInput = () => {
    hasInputSinceLoad = true;
    flushVisibleContainers();
  };

  const mountAll = () => {
    hasInputSinceLoad = false; // 每次换页重新等待真实输入
    visibleContainers.clear();
    commentObserver ??= new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          if (entry.isIntersecting) visibleContainers.add(el);
          else visibleContainers.delete(el);
        }
        flushVisibleContainers();
      },
      // 严格进入视口才算（部分页面评论区就在折叠线下几像素，正 margin 会让挂载
      // 提前到换页瞬间，等于没修）
      { rootMargin: '0px 0px' },
    );
    document.querySelectorAll<HTMLElement>('[data-giscus]').forEach((el) => {
      if (commentObserver) commentObserver.observe(el);
    });
  };

  // 真实用户输入（信任事件才计入）：指针移动 / 滚轮 / 键盘
  document.addEventListener('pointermove', markRealInput, { passive: true, capture: true });
  document.addEventListener('wheel', markRealInput, { passive: true, capture: true });
  document.addEventListener('keydown', markRealInput, { capture: true });
  // 换页会替换整个 body：旧容器随旧文档销毁，换页前断开观察并清空
  document.addEventListener('astro:before-swap', () => {
    commentObserver?.disconnect();
    visibleContainers.clear();
  });

  // 主题切换时同步 giscus iframe 配色（完整主题已缓存，切换即时生效）
  window.addEventListener('theme:changed', (event) => {
    currentThemeName = (event as CustomEvent<string>).detail;
    postCurrentFullTheme();
  });

  document.addEventListener('astro:page-load', mountAll);
</script>
