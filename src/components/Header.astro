---
/**
 * 移动端顶部栏（对应旧站 components/Header，lg 以下显示）
 * 导航激活态在构建期由 Astro.url.pathname 决定
 */
// 图标全部取自 src/components/icons（lucide-react@0.279 几何 vendor），理由见 MIGRATION.md「图标 vendor」
import BookOpen from '@/components/icons/BookOpen.astro';
import Codepen from '@/components/icons/Codepen.astro';
import Ghost from '@/components/icons/Ghost.astro';
import HeartPulse from '@/components/icons/HeartPulse.astro';
import ScrollText from '@/components/icons/ScrollText.astro';
import Sparkles from '@/components/icons/Sparkles.astro';
import '@/components/Header.css';

const navItems = [
  { href: '/', name: '文章', Icon: ScrollText },
  { href: '/inspiration', name: '靈感', Icon: Sparkles },
  { href: '/project', name: '項目', Icon: Codepen },
  { href: '/book', name: '書閣', Icon: BookOpen },
  { href: '/friend', name: '友鄰', Icon: HeartPulse },
  { href: '/about', name: '自述', Icon: Ghost },
];

const { pathname } = Astro.url;
---

<div class="header fixed z-10 flex h-16 w-screen items-center justify-between px-6 shadow-sm lg:hidden" transition:persist="header">
  <!-- 移动端菜单遮罩：菜单弹出时覆盖全屏空白区（拦截下层点击），点遮罩收起 -->
  <div class="nav-backdrop" data-nav-backdrop hidden></div>

  <h3 class="title text-4xl tracking-wider"><a href="/" class="text-current no-underline">字嶼隅</a></h3>

  <nav class="nav hidden items-center sm:flex">
    {
      navItems.map(({ href, name, Icon }) => (
        <a class={pathname === href ? 'active' : undefined} href={href}>
          <Icon />
          {name}
        </a>
      ))
    }
  </nav>

  <div class="toggle flex w-7 flex-col sm:hidden" data-toggle-nav>
    <span></span>
    <span></span>
    <span></span>
  </div>
</div>

<script>
  // 移动端导航：开合 + 遮罩 + 换页同步（事件委托：换页后自动生效）
  const closeNav = () => {
    document.querySelector('.header .nav')?.classList.remove('over');
    document.querySelector('.header [data-toggle-nav]')?.classList.remove('active');
    document.querySelector('[data-nav-backdrop]')?.setAttribute('hidden', '');
  };

  const toggleNav = () => {
    const opened = document.querySelector('.header .nav')?.classList.toggle('over');
    document.querySelector('.header [data-toggle-nav]')?.classList.toggle('active', opened);
    document.querySelector('[data-nav-backdrop]')?.toggleAttribute('hidden', !opened);
  };

  // 汉堡按钮：开合菜单 + 同步遮罩（保留原有上方交互区开关）
  document.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('[data-toggle-nav]')) toggleNav();
  });

  // 点击遮罩空白：收起菜单与遮罩（遮罩本身拦截下层点击，不穿透）
  document.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('[data-nav-backdrop]')) closeNav();
  });

  // 点击菜单内链接：跳转前收起（同页点击与跨页跳转均覆盖）
  document.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('.header .nav a')) closeNav();
  });

  // 换页后自动收起：Header 带 transition:persist，不随换页重置，须主动同步
  document.addEventListener('astro:after-swap', closeNav);
</script>
