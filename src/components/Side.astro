---
/**
 * 桌面端侧栏（对应旧站 components/Side）
 * 垂直导航 + 站名诗句 + 社交链接 + 蝴蝶按钮（主题面板入口）
 */
import Butterfly from '@/components/Butterfly.astro';
import ShootingStar from '@/components/ShootingStar.astro';
import Site from '@/components/Site.astro';
import config from '@/utils/config';
import { isNavActive } from '@/utils/nav';
// 导航项（href / name / Icon）统一在 utils/navItems —— 与 Header.astro 共用同一份数据
import { navItems } from '@/utils/navItems';
// 图标全部取自 src/components/icons（lucide-react@0.279 几何 vendor），理由见 MIGRATION.md「图标 vendor」
import BookBookmark from '@/components/icons/BookBookmark.astro';
import Github from '@/components/icons/Github.astro';
import Mail from '@/components/icons/Mail.astro';
import Music from '@/components/icons/Music.astro';
import Send from '@/components/icons/Send.astro';
import Twitter from '@/components/icons/Twitter.astro';
import '@/components/Side.css';

// 与旧站一致：全部渲染（含空链接的 twitter/telegram/music）；
// 末尾「书签」项（book-bookmark）对应 config.contact.bookmark，留空即不跳转
// name 仅供 aria-label 使用（链接内只有 <svg>，否则屏幕阅读器读不出名字）。
// ⚠️ 不要顺手加 data-name：sideInteraction.ts 的 KEEP_SELECTOR 是 `.side .nav a[data-name]`，
//    社媒链接同样在 `.nav` 里，加上就会被卷进 hover-keep 状态机、并长出 tooltip。
const socialItems = [
  { href: config.contact.github, name: 'GitHub', Icon: Github },
  { href: config.contact.twitter, name: 'X', Icon: Twitter },
  { href: config.contact.telegram, name: 'Telegram', Icon: Send },
  { href: config.contact.email, name: 'Email', Icon: Mail },
  { href: config.contact.music, name: 'Spotify', Icon: Music },
  { href: config.contact.bookmark, name: 'HelloGitHub', Icon: BookBookmark },
];

const { pathname } = Astro.url;
---

<div class="side sticky top-0 hidden h-screen min-w-[24rem] flex-col items-start justify-between lg:flex" transition:persist="side">
  <ShootingStar />

  <!-- side menu -->
  <!-- 导航 <a> 必须带 aria-label：链接内容只有一个 <svg>，屏幕阅读器读不出名字
       （Lighthouse link-name 审计失败 6 个元素，2026-10-31 修）。
       data-name 同时保留 —— CSS tooltip 与 scripts/sideInteraction.ts 的
       选择器 `.side .nav a[data-name]` 都依赖它，不要因为有了 aria-label 就删。 -->
  <div class="z-20 flex h-3/5 w-full justify-end">
    <nav class="nav nav-y flex w-12 flex-col items-center justify-end">
      {
        navItems.map(({ href, name, Icon }) => (
          <a
            class={isNavActive(href, pathname) ? 'active' : undefined}
            href={href}
            data-name={name}
            aria-label={name}
          >
            <Icon />
          </a>
        ))
      }
    </nav>

    <Site />
  </div>

  <!-- footer menu -->
  <div class="flex justify-end py-12">
    <div class="nya" data-name="COLORS" data-toggle-panel>
      <Butterfly />
    </div>
    <div class="nav nav-x flex h-12 items-center">
      {
        socialItems.map(({ href, name, Icon }) => (
          <a href={href} aria-label={name} rel="noopener noreferrer" target="_blank">
            <Icon />
          </a>
        ))
      }
    </div>
  </div>
</div>

<script>
  // 主题面板开合（事件委托）
  document.addEventListener('click', (event) => {
    const toggle = (event.target as HTMLElement).closest('[data-toggle-panel]');
    if (!toggle) return;
    const panel = document.querySelector('.panel');
    if (!panel) return;
    panel.toggleAttribute('hidden');
    // 重新显示时重放面板下落动画
    const main = panel.querySelector('.main');
    if (main instanceof HTMLElement && !panel.hasAttribute('hidden')) {
      main.style.animation = 'none';
      void main.offsetWidth;
      main.style.animation = '';
    }
  });
</script>

<script>
  /*
   * hover-keep 状态机 + 导航指针锁已整体搬到 src/scripts/sideInteraction.ts
   * （2026-10-31 逐字平移）。本模块只挂 document 级委托监听，import 即生效。
   */
  import '../scripts/sideInteraction';
</script>
