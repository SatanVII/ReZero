---
/**
 * 桌面端侧栏（对应旧站 components/Side）
 * 垂直导航 + 站名诗句 + 社交链接 + 蝴蝶按钮（主题面板入口）
 */
import Butterfly from '@/components/Butterfly.astro';
import Panel from '@/components/Panel.astro';
import ShootingStar from '@/components/ShootingStar.astro';
import Site from '@/components/Site.astro';
import config from '@/utils/config';
// 图标全部取自 src/components/icons（lucide-react@0.279 几何 vendor），理由见 MIGRATION.md「图标 vendor」
import BookOpen from '@/components/icons/BookOpen.astro';
import Codepen from '@/components/icons/Codepen.astro';
import Ghost from '@/components/icons/Ghost.astro';
import Github from '@/components/icons/Github.astro';
import Globe from '@/components/icons/Globe.astro';
import HeartPulse from '@/components/icons/HeartPulse.astro';
import Mail from '@/components/icons/Mail.astro';
import Music from '@/components/icons/Music.astro';
import ScrollText from '@/components/icons/ScrollText.astro';
import Send from '@/components/icons/Send.astro';
import Sparkles from '@/components/icons/Sparkles.astro';
import Twitter from '@/components/icons/Twitter.astro';
import '@/components/Side.css';

const navItems = [
  { href: '/', name: '文章', Icon: ScrollText },
  { href: '/inspiration', name: '隨想', Icon: Sparkles },
  { href: '/project', name: '項目', Icon: Codepen },
  { href: '/book', name: '書閣', Icon: BookOpen },
  { href: '/friend', name: '友鄰', Icon: HeartPulse },
  { href: '/about', name: '自述', Icon: Ghost },
];

// 与旧站一致：全部渲染（含空链接的 twitter/telegram/music）
const socialItems = [
  { href: config.contact.github, Icon: Github },
  { href: config.contact.twitter, Icon: Twitter },
  { href: config.contact.telegram, Icon: Send },
  { href: config.contact.email, Icon: Mail },
  { href: config.contact.music, Icon: Music },
];

const { pathname } = Astro.url;
---

<div class="side sticky top-0 hidden h-screen min-w-[24rem] flex-col items-start justify-between lg:flex" transition:persist="side">
  <ShootingStar />
  <Panel hidden></Panel>

  <!-- side menu -->
  <div class="z-20 flex h-3/5 w-full justify-end">
    <nav class="nav nav-y flex w-12 flex-col items-center justify-end">
      {
        navItems.map(({ href, name, Icon }) => (
          <a class={pathname === href ? 'active' : undefined} href={href} data-name={name}>
            <Icon />
          </a>
        ))
      }
    </nav>

    <Site />
  </div>

  <!-- footer menu -->
  <div class="flex justify-end py-12">
    <div class="nya" data-name="STORM" data-toggle-panel>
      <Butterfly />
    </div>
    <div class="nav nav-x flex h-12 items-center">
      {
        socialItems.map(({ href, Icon }) => (
          <a href={href} rel="noopener noreferrer" target="_blank">
            <Icon />
          </a>
        ))
      }
      <a>
        <Globe />
      </a>
    </div>
  </div>
</div>

<script>
  // 主题面板开合（事件委托）
  document.addEventListener('click', (event) => {
    const toggle = (event.target as HTMLElement).closest('[data-toggle-panel]');
    if (!toggle) return;
    const panel = document.querySelector('.panel');
    if (!panel) return;
    panel.toggleAttribute('hidden');
    // 重新显示时重放面板下落动画
    const main = panel.querySelector('.main');
    if (main instanceof HTMLElement && !panel.hasAttribute('hidden')) {
      main.style.animation = 'none';
      void main.offsetWidth;
      main.style.animation = '';
    }
  });
</script>

<script>
  /*
   * ★ hover-keep（对齐 zero-astro 4a96118 原始实现）
   *
   * 行为：点击侧边栏交互项换页时，该项的文字提示与图标位移全程保持——
   * 换页落地后 :hover 重新建立，样式恒定；鼠标移开交互区才回落（回位
   * 动画与常态一致）。普通悬浮（未点击）仍由原生 :hover 表现，无需类。
   *
   * 诊断依据（真实点击 + 40ms 采样）：swap 会把 persist 的侧栏 DOM 移除重插，
   * :hover 在 swap 起始瞬间即丢失（早于 astro:before-swap 事件），期间提示消失、
   * 图标回跳基准位；重插后 :hover 恢复还会重播 0.3s 位移过渡。
   *
   * 三层加类时机 + pointermove 撤销：
   *   1. click 委托（最早）——点击瞬间就把类加上，与 :hover 并存，swap 全程样式恒定
   *   2. astro:before-swap 兜底键盘/程序化导航
   *   3. astro:after-swap 按实际 :hover 校正（transition:persist 复用同一 DOM 节点，
   *      类随节点进入新树，新树首次样式计算即终态）
   *   4. pointermove 委托撤销——重插后 pointerout 可能缺失，移动即校验；
   *      鼠标移出交互区才撤类
   * 监听全挂 document 上——换页保留、模块脚本不会重跑。
   */
  let keepEl: Element | null = null;
  const KEEP_SELECTOR = '.side .nav a[data-name], .side .nya';

  const setKeep = (el: Element | null) => {
    if (el === keepEl) return;
    keepEl?.classList.remove('hover-keep');
    keepEl = el;
    keepEl?.classList.add('hover-keep');
  };

  // 1. 点击瞬间（最早时机）
  document.addEventListener('click', (event) => {
    const el = (event.target as HTMLElement).closest(KEEP_SELECTOR);
    if (el) setKeep(el);
  });

  // 2. 换页前兜底（键盘/程序化导航无 click）：只加不清——撤销统一交给 pointermove，
  //    避免 after-swap 瞬间 hit-test 未完成时清类造成一帧空窗
  document.addEventListener('astro:before-swap', () => {
    const el = document.querySelector('.side .nav a[data-name]:hover, .side .nya:hover');
    if (el) setKeep(el);
  });

  // 3. 换页落地校正：:hover 已恢复则转移到该项；未恢复则保留现有 keep（pointermove 随后接管）
  document.addEventListener('astro:after-swap', () => {
    const el = document.querySelector('.side .nav a[data-name]:hover, .side .nya:hover');
    if (el) setKeep(el);
  });

  // 4. 低频指针事件撤销：进入其他交互项时转移，离开交互区（relatedTarget 不在 keep 内）时撤销。
  //    pointerover/out 仅在跨越元素边界时触发，取代 pointermove 的逐帧采样（原先每次
  //    鼠标移动都会跑一次 closest，是侧栏交互迟缓的次要因素）。
  document.addEventListener('pointerover', (event) => {
    const el = (event.target as HTMLElement).closest(KEEP_SELECTOR);
    if (el && el !== keepEl) setKeep(el);
  });
  document.addEventListener('pointerout', (event) => {
    if (!keepEl) return;
    const related = (event as PointerEvent).relatedTarget as HTMLElement | null;
    if (related && (keepEl === related || keepEl.contains(related))) return; // keep 内部子元素间移动
    const next = related?.closest?.(KEEP_SELECTOR) ?? null;
    if (next !== keepEl) setKeep(next);
  });
</script>
