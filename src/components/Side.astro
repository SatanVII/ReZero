---
/**
 * 桌面端侧栏（对应旧站 components/Side）
 * 垂直导航 + 站名诗句 + 社交链接 + 蝴蝶按钮（主题面板入口）
 */
import Butterfly from '@/components/Butterfly.astro';
import Panel from '@/components/Panel.astro';
import ShootingStar from '@/components/ShootingStar.astro';
import Site from '@/components/Site.astro';
import config from '@/utils/config';
// 图标全部取自 src/components/icons（lucide-react@0.279 几何 vendor），理由见 MIGRATION.md「图标 vendor」
import BookOpen from '@/components/icons/BookOpen.astro';
import Codepen from '@/components/icons/Codepen.astro';
import Ghost from '@/components/icons/Ghost.astro';
import Github from '@/components/icons/Github.astro';
import Globe from '@/components/icons/Globe.astro';
import HeartPulse from '@/components/icons/HeartPulse.astro';
import Mail from '@/components/icons/Mail.astro';
import Music from '@/components/icons/Music.astro';
import ScrollText from '@/components/icons/ScrollText.astro';
import Send from '@/components/icons/Send.astro';
import Sparkles from '@/components/icons/Sparkles.astro';
import Twitter from '@/components/icons/Twitter.astro';
import '@/components/Side.css';

const navItems = [
  { href: '/', name: '文章', Icon: ScrollText },
  { href: '/inspiration', name: '隨想', Icon: Sparkles },
  { href: '/project', name: '項目', Icon: Codepen },
  { href: '/book', name: '書閣', Icon: BookOpen },
  { href: '/friend', name: '友鄰', Icon: HeartPulse },
  { href: '/about', name: '自述', Icon: Ghost },
];

// 与旧站一致：全部渲染（含空链接的 twitter/telegram/music）
const socialItems = [
  { href: config.contact.github, Icon: Github },
  { href: config.contact.twitter, Icon: Twitter },
  { href: config.contact.telegram, Icon: Send },
  { href: config.contact.email, Icon: Mail },
  { href: config.contact.music, Icon: Music },
];

const { pathname } = Astro.url;
---

<div class="side sticky top-0 hidden h-screen min-w-[24rem] flex-col items-start justify-between lg:flex" transition:persist="side">
  <ShootingStar />
  <Panel hidden></Panel>

  <!-- side menu -->
  <div class="z-20 flex h-3/5 w-full justify-end">
    <nav class="nav nav-y flex w-12 flex-col items-center justify-end">
      {
        navItems.map(({ href, name, Icon }) => (
          <a class={pathname === href ? 'active' : undefined} href={href} data-name={name}>
            <Icon />
          </a>
        ))
      }
    </nav>

    <Site />
  </div>

  <!-- footer menu -->
  <div class="flex justify-end py-12">
    <div class="nya" data-name="STORM" data-toggle-panel>
      <Butterfly />
    </div>
    <div class="nav nav-x flex h-12 items-center">
      {
        socialItems.map(({ href, Icon }) => (
          <a href={href} rel="noopener noreferrer" target="_blank">
            <Icon />
          </a>
        ))
      }
      <a>
        <Globe />
      </a>
    </div>
  </div>
</div>

<script>
  // 主题面板开合（事件委托）
  document.addEventListener('click', (event) => {
    const toggle = (event.target as HTMLElement).closest('[data-toggle-panel]');
    if (!toggle) return;
    const panel = document.querySelector('.panel');
    if (!panel) return;
    panel.toggleAttribute('hidden');
    // 重新显示时重放面板下落动画
    const main = panel.querySelector('.main');
    if (main instanceof HTMLElement && !panel.hasAttribute('hidden')) {
      main.style.animation = 'none';
      void main.offsetWidth;
      main.style.animation = '';
    }
  });
</script>

<script>
  /*
   * ★ hover-keep（对齐 zero-astro 4a96118 原始实现）
   *
   * 行为：点击侧边栏交互项换页时，该项的文字提示与图标位移全程保持——
   * 换页落地后 :hover 重新建立，样式恒定；鼠标移开交互区才回落（回位
   * 动画与常态一致）。普通悬浮（未点击）仍由原生 :hover 表现，无需类。
   *
   * 诊断依据（真实点击 + 40ms 采样）：swap 会把 persist 的侧栏 DOM 移除重插，
   * :hover 在 swap 起始瞬间即丢失（早于 astro:before-swap 事件），期间提示消失、
   * 图标回到常态位置；重插后 :hover 恢复还会重播 0.3s 位移过渡。
   *
   * 四层加类/撤销时机 + pointerover/out 撤销：
   *   1. click 委托（最早）——点击瞬间就把类加上，与 :hover 并存，swap 全程样式恒定
   *   2. astro:before-swap 兜底键盘/程序化导航
   *   3. astro:after-swap 按实际 :hover 校正（transition:persist 复用同一 DOM 节点，
   *      类随节点进入新树，新树首次样式计算即终态）
   *   4. pointerover/out 委托撤销——跨入其他交互项时转移，离开交互区时撤销；
   *      取代 pointermove 的逐帧采样（原先每次鼠标移动都会跑一次 closest）
   * 监听全挂 document 上——换页保留、模块脚本不会重跑。
   */
  let keepEl: Element | null = null;
  const KEEP_SELECTOR = '.side .nav a[data-name], .side .nya';

  const setKeep = (el: Element | null) => {
    if (el === keepEl) return;
    keepEl?.classList.remove('hover-keep');
    keepEl = el;
    keepEl?.classList.add('hover-keep');
  };

  // 1. 点击瞬间（最早时机）
  document.addEventListener('click', (event) => {
    const el = (event.target as HTMLElement).closest(KEEP_SELECTOR);
    if (el) setKeep(el);
  });

  /*
   * 无条件恢复 hover-keep：Astro 重插 persist 元素时会清除运行时添加的类，
   * 且此刻 :hover 尚未重算（实测仍为 false），因此**不能依赖 :hover 查询**——
   * 否则 hover-keep 丢失 → tooltip 隐藏 → 恢复后再淡入（文字闪一下）。
   */
  const restoreKeep = () => {
    keepEl?.classList.add('hover-keep');
    // 节点被替换时按 href 兜底定位
    const href = keepEl?.getAttribute('href');
    if (href) {
      const found = document.querySelector(`.side .nav a[href="${href}"]`);
      if (found && found !== keepEl) {
        keepEl = found;
        found.classList.add('hover-keep');
      }
    }
  };

  /* 把 hover-keep 同步到当前 :hover 的那一项（换页前后各调一次） */
  const syncKeepToHover = () => {
    const el = document.querySelector('.side .nav a[data-name]:hover, .side .nya:hover');
    if (el && el !== keepEl) setKeep(el);
  };

  // 2. 换页前兜底（键盘/程序化导航无 click）
  document.addEventListener('astro:before-swap', () => {
    restoreKeep();
    syncKeepToHover();
  });

  // 3. 换页落地校正
  document.addEventListener('astro:after-swap', () => {
    restoreKeep();
    syncKeepToHover();
  });

  /*
   * 注意：no-anim 的施加与移除统一在下方「导航状态统一管理」段落里处理
   * （那里带同址导航判定与兜底看门狗）。此处不再单独注册，避免同址导航时
   * 只加了 no-anim 却永远没人移除（实测缺陷 B3）。
   */

  // 4. 低频指针事件撤销：进入其他交互项时转移，离开交互区（relatedTarget 不在 keep 内）时撤销。
  //    pointerover/out 仅在跨越元素边界时触发，取代 pointermove 的逐帧采样（原先每次
  //    鼠标移动都会跑一次 closest，是侧栏交互迟缓的次要因素）。
  //    ★ 导航期间（html.navigating）只跳过 **pointerover**：DOM swap 重插会派发伪
  //      pointerover，据此转移 hover-keep 会把提示转到错误项上。
  //      （pointerout 刻意不用此守卫——见下方说明。）
  const isNavigating = () => document.documentElement.classList.contains('navigating');

  document.addEventListener('pointerover', (event) => {
    if (isNavigating()) return;
    const el = (event.target as HTMLElement).closest(KEEP_SELECTOR);
    if (el && el !== keepEl) setKeep(el);
  });
  document.addEventListener('pointerout', (event) => {
    /*
     * 注意：**不能**在这里用 isNavigating() 提前 return。navigating 会持锁 600ms，
     * 用户点击后通常在这段时间内就移开鼠标——一旦整体忽略，hover-keep 永不撤销，
     * 文字就再也收不回去了（实测反复出现的 bug）。
     * 伪 pointerout 的过滤交给下面的坐标判定即可（伪事件的指针仍在图标盒内）。
     */
    if (!keepEl) return;
    const pe = event as PointerEvent;
    const related = pe.relatedTarget as HTMLElement | null;
    if (related && (keepEl === related || keepEl.contains(related))) return; // keep 内部子元素间移动
    /*
     * ★ 伪 pointerout 过滤：DOM swap 移出元素时会派发一次 pointerout，但指针
     *   实际仍停在原处。判据是「指针当前坐标是否仍在**该项图标盒**内」——
     *   在则视为伪事件，不撤销；不在则立即撤销（指针离开图标即收起文字）。
     *   注意不要用侧栏/热区等更大范围，否则离开图标后文字不收回。
     */
    const r = keepEl.getBoundingClientRect();
    const stillOnItem =
      pe.clientX >= r.left && pe.clientX <= r.right && pe.clientY >= r.top && pe.clientY <= r.bottom;
    if (stillOnItem) return;
    const next = related?.closest?.(KEEP_SELECTOR) ?? null;
    if (next !== keepEl) setKeep(next);
  });

  /* ==========================================================================
   * 导航状态统一管理（含兜底看门狗）
   *
   * 背景（2026-09-25 边界审计发现的 3 个缺陷）：原先「施加状态」与「清理状态」
   * 分处不同事件，一旦导航不会走到清理分支，状态就永久残留。实测三种触发方式：
   *   ① Ctrl/Cmd+点击、或 target=_blank 链接 → 当前页不导航 → astro:page-load
   *      不触发 → .navigating 永久残留 → <html> 的 cursor:pointer 让全站指针恒为手型
   *   ② 同址导航（如首页点站名 → /）：只触发 before-swap，不触发 after-swap/page-load
   *      → .no-anim 与 12 个 .nav a 的 inline 颜色冻结永久残留
   *      → tooltip 不再淡入淡出、active 高亮颜色从此不再更新
   *
   * 对策：① 点击时先判断「是否真的会导航当前页」；② 统一清理函数 + 兜底看门狗。
   * ========================================================================== */

  /** 释放颜色冻结（幂等：只处理确实被冻结过的元素） */
  const releaseColor = (a: HTMLElement) => {
    if (!a.style.transition && !a.style.color) return;
    a.style.transition = '';
    void a.offsetWidth; // 强制 reflow：确保 transition 已恢复后再改 color
    a.style.color = '';
  };
  const releaseAllColors = () => {
    document.querySelectorAll<HTMLElement>('.side .nav a').forEach(releaseColor);
  };

  /* ---------- 指针锁（html.navigating） ---------- */
  let navLockActive = false;
  /** 锁定状态已交给「指针是否还在侧栏交互项内」判定（见 releaseIfPointerLeftSide） */
  let awaitingPointerRelease = false;
  /** 最近一次指针位置（几何判定的输入；由 trackPointer 维护） */
  let lastPX = 0;
  let lastPY = 0;
  /** 导航序号：每次上锁自增，供延迟回调判断「期间是否又开始了新导航」 */
  let navSeq = 0;

  const applyNavLock = () => {
    navSeq++;
    navLockActive = true;
    document.documentElement.classList.add('navigating');
  };
  const dropNavLock = () => {
    navLockActive = false;
    document.documentElement.classList.remove('navigating');
  };

  /*
   * ClientRouter 在 swap 中会重建 <html> 的属性（class 被一并抹掉）。原先只依赖
   * astro:after-swap 补回，但「被抹掉 → after-swap」之间存在数帧空窗，期间指针会
   * 从手型回落成箭头（逐帧采样可见 cursor 出现 auto）。用 MutationObserver 在 class
   * 变动的当下立即补回，彻底消除该空窗。
   */
  new MutationObserver(() => {
    if (navLockActive && !document.documentElement.classList.contains('navigating')) {
      document.documentElement.classList.add('navigating');
    }
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  // 跟踪指针位置（供下面的几何判定与 hover-keep 撤销使用）
  const trackPointer = (event: Event) => {
    const pe = event as PointerEvent;
    lastPX = pe.clientX;
    lastPY = pe.clientY;
  };
  document.addEventListener('pointermove', trackPointer, true);
  document.addEventListener('pointerdown', trackPointer, true);

  /*
   * 指针是否仍压在某个侧栏交互项（导航图标盒 / 蝴蝶）的矩形内？
   *
   * ★ 必须用 getBoundingClientRect() 做**几何判定**，绝不能用 document.elementFromPoint()。
   *   实测（visual-audit/probe-nav-geometry.mjs；CPU 节流 x8 / x20 复现）：
   *   换页 swap 期间侧栏 persist 子树正在被搬移，**短暂不可命中** ——
   *   `elementFromPoint(图标坐标)` 会返回 <html>，而同一时刻该项的 rect 完全正确。
   *   若用 elementFromPoint 当解锁判据，就会在该窗口内误判「指针已不在交互项上」而撤锁；
   *   撤锁那一瞬间浏览器把光标定为箭头，而**光标要等下一次鼠标移动才会重算**
   *   → 用户看到「点击后指针一直变成箭头」（本项目反复出现、且只在部分页面复现的 bug）。
   */
  const pointerInSideItem = () => {
    const items = document.querySelectorAll<HTMLElement>('.side .nav a[data-name], .side .nya');
    for (const el of items) {
      const r = el.getBoundingClientRect();
      if (lastPX >= r.left && lastPX <= r.right && lastPY >= r.top && lastPY <= r.bottom) return true;
    }
    return false;
  };

  /** 指针已离开侧栏交互项 → 解锁；仍在项内 → 保持锁（这就是「点击后保持手型」） */
  const releaseIfPointerLeftSide = () => {
    if (!navLockActive || pointerInSideItem()) return;
    awaitingPointerRelease = false;
    dropNavLock();
  };

  /** 统一清理：把侧栏恢复到常态（导航结束或被取消时都走这里） */
  const cleanupNavState = () => {
    awaitingPointerRelease = false;
    dropNavLock();
    document.querySelector('.side')?.classList.remove('no-anim');
    releaseAllColors();
  };

  /*
   * 兜底看门狗：每次施加导航状态时重置。
   * 无论导航以何种方式中断（修饰键/新窗口点击未触发导航、fetch 失败、用户中止、
   * 或指针始终静止导致 awaitingPointerRelease 一直挂着），2.5s 内必定把侧栏恢复到常态。
   */
  let navWatchdog = 0;
  const armWatchdog = () => {
    window.clearTimeout(navWatchdog);
    navWatchdog = window.setTimeout(cleanupNavState, 2500);
  };

  /**
   * 该次点击是否会**导航当前页**？只有「修饰键」与「新窗口目标」算「不会导航」。
   *
   * ★ 切勿再加「同址点击不换页」的判据（这是曾经写下的错误假设）。
   *   实测探针 visual-audit/probe-same-url.mjs 已证明：ClientRouter 对**同址点击**
   *   同样走完整流程 —— before-preparation → after-preparation → before-swap →
   *   after-swap → page-load（to=/）。既然同址点击真的会换页，就必须照常加指针锁；
   *   否则该次 swap 期间 persist 的侧栏暂时离场、指针命中不到任何元素，
   *   光标从手型回落成箭头（回归断言「换页期间指针恒为 pointer」里出现的 auto）。
   */
  const willNavigateSelf = (event: MouseEvent, link: HTMLAnchorElement) => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return false;
    const target = link.getAttribute('target');
    if (target && target !== '_self') return false;
    return true;
  };

  /*
   * 点击：只在「确实会导航当前页」时加指针锁。
   * 若不加此判断，Ctrl+点击 / target=_blank（底部社交图标）不会换页，
   * 一次 astro:page-load 都没有，指针锁只能等看门狗解除（实测缺陷 B1/B2）。
   */
  document.addEventListener('click', (event) => {
    const me = event as MouseEvent;
    const a = (me.target as HTMLElement).closest('.side .nav a[href]') as HTMLAnchorElement | null;
    if (!a || !willNavigateSelf(me, a)) return;
    applyNavLock();
    armWatchdog();
  });

  /* 换页开始：加锁 + 冻结颜色 + 上表看门狗 */
  document.addEventListener('astro:before-swap', () => {
    /*
     * 注意：不要在这里做「同址导航跳过」的优化。实测同址点击同样会 swap
     * （见 willNavigateSelf 说明），跳过会让该次 swap 全程没有指针锁。
     * 若导航异常中断，看门狗会在 2.5s 内把状态清干净。
     */
    applyNavLock();
    document.querySelector('.side')?.classList.add('no-anim');
    /*
     * active 颜色过渡重放（对齐 yun37.me 的 0.3s 平滑渐变）：
     * Astro 的 DOM swap 会把 persist 的侧栏子树移出文档再插入，元素重插时浏览器
     * 重新计算样式、**没有"上一个值"可比较** → active 颜色直接以终态渲染（瞬切）。
     * 这里先把当前颜色冻结成 inline，重插后视觉保持原样；落地后再释放 → 浏览器
     * 看到「冻结色 → 类色」的真实变化 → 0.3s 过渡正常播放。
     */
    document.querySelectorAll<HTMLElement>('.side .nav a').forEach((a) => {
      a.style.transition = 'none';
      a.style.color = getComputedStyle(a).color;
    });
    armWatchdog();
  });

  /*
   * 换页落地：ClientRouter 会重建 <html> 属性（class 被一并抹掉）。
   * 补回交给 applyNavLock()；「被抹掉 → after-swap」之间的空窗由上面的
   * MutationObserver 即时补回（那才是指针回落成箭头的真正窗口）。
   */
  document.addEventListener('astro:after-swap', () => {
    applyNavLock();
    const side = document.querySelector('.side');
    if (!side) return;
    requestAnimationFrame(() => requestAnimationFrame(() => side.classList.remove('no-anim')));
  });

  /* 落地后：尽早释放颜色冻结（颜色过渡要立刻开始）；指针锁见下 */
  document.addEventListener('astro:page-load', () => {
    requestAnimationFrame(releaseAllColors); // 等一帧，确保 updateActiveNav() 已改完 active 类
    /*
     * ★ 指针锁的解锁判据：**只在「指针确实不在侧栏交互项上」时解锁**，且用几何判定。
     *
     * 不要按固定时长解锁（曾用 600ms），也不要用 document.elementFromPoint 判定
     * （曾被这个问题坑两次）：换页 swap 期间侧栏短暂不可命中，elementFromPoint 会答
     * 「指针下什么都没有」→ 误判 → 在指针仍压在图标上时撤锁 → 箭头。
     * 详见 pointerInSideItem() 的说明与 probe-nav-geometry.mjs 的实测数据。
     *
     * 多次复查是为了兼顾「页面内链点击」这类指针本来就在正文上的场景，
     * 让全局 html 手型不必无谓地留到看门狗超时；指针在项内则一直保持锁。
     * navSeq 判定：复查窗口内若用户又点了另一项（新导航已开始），本次复查让位。
     */
    awaitingPointerRelease = true;
    const mySeq = navSeq;
    for (const delay of [400, 900, 1500]) {
      window.setTimeout(() => {
        if (navSeq !== mySeq || !awaitingPointerRelease) return;
        releaseIfPointerLeftSide();
      }, delay);
    }
  });

  /*
   * 指针移动：仍压在侧栏交互项内 → 继续保持手型（含点击后在图标上小幅移动）；
   * 一旦离开交互项 → 立即解锁，让页面自己的光标生效。
   */
  document.addEventListener(
    'pointermove',
    () => {
      if (!awaitingPointerRelease) return;
      releaseIfPointerLeftSide();
    },
    true,
  );

  /*
   * 补充触发点：pointerout。
   *
   * 指针移出**父文档**（例如落到页面里的 <iframe> 上、或移出窗口）时，父文档不会再收到
   * pointermove，只会有一次 pointerout —— 只靠 pointermove 会让锁一直挂到看门狗超时。
   * 这里可以安全复用 pointerout：判据是**几何**（指针坐标是否仍在项盒内），不依赖
   * relatedTarget，因此 DOM swap 派发的伪 pointerout 不会造成误解锁（那时指针仍在项内）。
   */
  document.addEventListener(
    'pointerout',
    () => {
      if (!awaitingPointerRelease) return;
      releaseIfPointerLeftSide();
    },
    true,
  );
</script>
