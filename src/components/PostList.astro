---
/**
 * 文章列表（对应旧站 article 的 React 列表页）
 * - 无限滚动改为构建期全量渲染（个人博客体量下 SEO 与体验更优）
 * - 悬浮 mask 跟随 + 进场定位到第一条文章（见页尾脚本）+ AOS 滚动动画
 */
import type { CollectionEntry } from 'astro:content';
import { format } from 'date-fns';
import Bookmark from '@/components/icons/Bookmark.astro';
import Calendar from '@/components/icons/Calendar.astro';
import Tag from '@/components/icons/Tag.astro';
import { excerpt } from '@/utils/excerpt';

interface Props {
  entries: CollectionEntry<'post'>[];
}

const { entries } = Astro.props;
---

<div class="page px-0" data-list-container>
  <!-- 悬停滑动遮罩：class 与旧站一致；初始 height:0 使进场前不可见，脚本执行后动画定位到第一条 -->
  <div
    class="mask pointer-events-none absolute left-0 top-0 w-full transform rounded transition-all duration-300 ease-in-out"
    data-list-mask
    style="height: 0px; transform: translateY(0px)"></div>
  <div class="relative space-y-4" data-post-list>
    {
      entries.map((entry) => (
        <a
          href={`/posts/${entry.id}`}
          class="block cursor-pointer p-4"
          data-post-item
          data-aos="fade-left"
        >
          <h2 class="mb-2 text-xl italic">{entry.data.title}</h2>
          <p class="my-0 text-[17px]">{excerpt(entry)}</p>
          <div class="meta mt-2 flex justify-start">
            <Calendar class="mr-1" />
            {format(entry.data.date, 'yyyy-MM-dd')}
            <Bookmark class="ml-4 mr-1" />
            {entry.data.category}
            <Tag class="ml-4 mr-1" />
            {entry.data.tags.map((tag, index) => (
              <span class:list={['mr-2', index >= 1 && 'hidden sm:inline-block']}>{tag}</span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</div>

<script>
  /**
   * 文章列表悬停滑动遮罩
   *
   * 对应旧站 app/article/page.tsx 的 maskRef / calcMaskPos / handleMask / handleScroll。
   * 只写内联 height / transform，滑动交给 CSS 的
   * `transition-all duration-300 ease-in-out` —— 时长与缓动曲线因此天然与旧站相同。
   *
   * 进场定位（bug 修复）：旧站挂载后把 mask 定位到第一条文章
   * （useEffect 里 maskHeight === 0 的 setTimeout(100) 分支），指示框随 CSS 过渡
   * 动画滑入。此前迁移版只有 hover 跟随、漏掉了这段初始化，导致进入文字页时
   * 指示框停在页面顶部、无动画。实现与 inspiration.astro 的遮罩保持同一模式：
   *  - astro:page-load 进场定位第一条（含 ClientRouter 换页重进）
   *  - 悬停跟随（事件委托，换页后随 setup 重新绑定）
   *  - ResizeObserver：字体等异步资源改变条目高度时重新对齐（旧站只在 scroll 时重算）
   */
  let cleanup: (() => void) | null = null;

  const setup = () => {
    cleanup?.();
    cleanup = null;

    const mask = document.querySelector<HTMLElement>('[data-list-mask]');
    const container = document.querySelector<HTMLElement>('[data-list-container]');
    const list = document.querySelector<HTMLElement>('[data-post-list]');
    if (!mask || !list || !container) return;

    const items = () => [...list.querySelectorAll<HTMLElement>(':scope > [data-post-item]')];

    // 遮罩是 .page 的绝对定位子元素（top:0 贴 .page 顶边），
    // 而 a[data-post-item].offsetTop 相对 .relative 的列表容器 —— 故需补上 .page 的上内边距。
    // 上内边距是响应式的（py-24 → lg:py-16）：每次定位现读，避免窗口跨 lg 断口缩放后用到旧值
    //（垂直 padding 变化不改变列表内容盒尺寸，ResizeObserver 不会因此触发）。
    const moveTo = (item: HTMLElement) => {
      const paddingTop = Number.parseFloat(getComputedStyle(container).paddingTop) || 0;
      const height = `${item.offsetHeight}px`;
      const transform = `translateY(${item.offsetTop + paddingTop}px)`;
      // 与旧站 calcMaskPos 的早退守卫一致：位置不变不重复写样式（mouseover 高频触发）
      if (mask.style.height === height && mask.style.transform === transform) return;
      mask.style.height = height;
      mask.style.transform = transform;
    };

    // 进场：指示框动画滑向第一条文章（对应旧站挂载后的初始化）
    let current = items()[0] ?? null;
    if (current) moveTo(current);

    const onOver = (event: Event) => {
      const target = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-post-item]');
      if (!target || !list.contains(target)) return;
      current = target;
      moveTo(target);
    };
    list.addEventListener('mouseover', onOver);

    const observer = new ResizeObserver(() => {
      if (current) moveTo(current);
    });
    observer.observe(list);

    cleanup = () => {
      list.removeEventListener('mouseover', onOver);
      observer.disconnect();
    };
  };

  document.addEventListener('astro:page-load', setup);
</script>
