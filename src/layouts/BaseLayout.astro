---
/**
 * 全局布局（对应旧站 app/layout.tsx + app/template.tsx + app/context.tsx）
 * - Fonts API：--font-serif（正文衬线）/ --font-site（站名）
 * - ClientRouter：接管旧 template.tsx 的切页过渡
 * - 主题系统：配色由 ThemeStyles 在构建期编译成 CSS；运行时只决定"用哪一套"
 * - 正文图片/外链的增强在构建期由 satteri hast 插件完成（见 astro.config.mjs）
 */
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Side from '@/components/Side.astro';
import ThemeStyles from '@/components/ThemeStyles.astro';
import themes, { themeTypes } from '@/data/themes';
const themeImages = Object.fromEntries(themes.map((t) => [t.type, t.image]));
// 全站中文字体：霞鹜文楷（2026-09-17 由 Noto Serif SC 600 更换）。
// 自托管分片走 public（正文 <link> 与评论区内联共用，见 head 内 link 标签），
// lxgw-wenkai-webfont 包仅作为 prepare-fonts.mjs 的分片来源保留在 devDependencies。
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = '字嶼隅',
  description = '愿似飘飖五云影，从来从去九天间。',
  keywords = '抹茶',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="抹茶" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="字嶼隅" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://giscus.app" crossorigin />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- 霞鹜文楷（全站中文字体）：自托管分片，与评论区 data: URL 主题共用同一 css；
         换字体版本时 bump ?v（与 public/assets/styles/fonts/ 内容保持同步） -->
    <link rel="stylesheet" href="/assets/styles/fonts/lxgw-wenkai.css?v=1" />
    <!-- P0-1 字体子集：preload 单文件（字体 preload 必须 crossorigin），声明在分片之后使常用字命中子集、新字回落分片 -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/styles/fonts/lxgw-wenkai-subset.woff2?v=1" />
    <link rel="stylesheet" href="/assets/styles/fonts/lxgw-wenkai-subset.css?v=1" />
    <ThemeStyles />
    <!--
      首屏防闪：在首次绘制前把 data-theme 写到 <html> 上。
      配色/背景图由上面 ThemeStyles 在构建期编译成的 [data-theme='X'] 规则提供，
      这里只做"选哪一套"：读缓存 → 过期或无效则按访问次数轮换（不落盘，对齐旧站）。
      必须 is:inline 且放在 head（同步执行、阻塞首绘），否则会闪一下默认主题。
    -->
    <script is:inline define:vars={{ themeTypes, themeImages }}>
      (() => {
        // ClientRouter 换页会随新 head 重跑本脚本：完整加载（首访/刷新）才计数/定主题，
        // 换页时的主题由 astro:after-swap 补回机制维护（见下方模块脚本），
        // 否则 viewCount 会被换页不断推进、轮换游标失真。
        if (window.__themeBoot) return;
        window.__themeBoot = true;
        const LIST = themeTypes;
        const K = 'theme';
        const E = 'theme-expire';
        const V = 'viewCount';
        let type = '';
        try {
          // 访问计数：每次完整加载 +1（旧站 context.tsx 挂载时无条件 setCount(count+1)）
          const count = Number(localStorage.getItem(V)) || 0;
          localStorage.setItem(V, String(count + 1));
          const expire = Number(localStorage.getItem(E) || 0);
          const cached = localStorage.getItem(K) || '';
          if (expire && Date.now() < expire && LIST.includes(cached)) {
            type = cached; // 用户点选后 24h 内：保持所选主题
          } else {
            // 默认态（首次/过期/未点选）：按访问次数轮换。
            // 与旧站一致：先用**旧** count 取索引（首访 count=0 → 第一套胡桃），再落 count+1。
            // 且轮换值不落盘（theme-expire 只在用户点选时写入）——
            // 否则未点选时刷新不再换壁纸，即"刷新切换壁纸失效"。
            type = LIST[count % LIST.length];
          }
        } catch {
          /* localStorage 不可用（隐私模式等）：退回第一套主题 */
        }
        document.documentElement.dataset.theme = type || LIST[0];
        // P0-2：首绘前预载当前主题背景图（比等 CSS 解析后再发现提前一轮 RTT）
        const bg = themeImages[type || LIST[0]];
        if (bg) document.head.insertAdjacentHTML('beforeend', '<link rel="preload" as="image" href="' + bg + '">');
        // 供 CSS 判断"脚本可用"：无 JS 时不做图片渐显，避免正文图片永久不可见
        document.documentElement.classList.add('js');
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <!--
      布局组件在换页时保持不重建（对应旧站 Next App Router 的持久 layout）：
      指令写在**组件内部的根元素**上 —— transition:persist 放在普通 .astro 组件标签上
      只会被当作 prop 丢弃，不会生成 data-astro-transition-persist（已实测）。
    -->
    <Header />
    <Side />
    <div class="page-wrap">
      <slot />
    </div>

    <!-- 正文图片灯箱：构建期输出静态标记，运行时只挂一个委托监听器 -->
    <dialog id="photo-lightbox">
      <img alt="" />
      <p class="photo-caption"></p>
    </dialog>
  </body>
</html>

<script>
  /* ---------- 控制台彩蛋（旧站 utils/index.ts Nya） ---------- */
  const nya = () => {
    const labelStyle = 'line-height:22px;color:#FFF;background:#DB493C;border-radius:3px;';
    console.info(`%c 字嶼隅 %c`, labelStyle, '', 'https://github.com/SatanVII');
    console.info('%c 主题 %c', labelStyle, '', 'https://github.com/chanshiyucx/zero');
    console.info('~❀~ 发现控制台报错请务必联系博主 ~❀~');
  };

  /*
   * 主题系统（对应旧站 app/context.tsx）
   *
   * 配色已经搬到构建期：ThemeStyles.astro 把 8 套主题编译成 [data-theme='X'] 的 CSS，
   * 首屏由 head 里的 is:inline 脚本在首次绘制前把 data-theme 写到 <html> 上。
   * 这里只剩两件事：用户点选时改写 data-theme 并落盘；把主题面板与底部说明链接对齐。
   * 面板的文案/链接直接读面板项自身的 data-*，因此不再需要把主题数据塞进 HTML。
   */
  const STORE_KEY = 'theme';
  const EXPIRE_KEY = 'theme-expire';
  const EXPIRE = 24 * 60 * 60 * 1000;

  const syncThemePanel = (type: string) => {
    document.querySelectorAll('.panel [data-theme-item]').forEach((li) => {
      li.classList.toggle('active', li.getAttribute('data-theme-item') === type);
    });
    const description = document.querySelector<HTMLAnchorElement>('.panel .description');
    const current = document.querySelector(`.panel [data-theme-item='${type}']`);
    if (description && current) {
      description.href = current.getAttribute('data-theme-url') ?? '#';
      description.dataset.title = current.getAttribute('data-theme-description') ?? '';
    }
  };

  // 当前主题（首屏由 head 内联脚本定好，这里接手后续维护）
  let currentTheme = document.documentElement.dataset.theme ?? '';

  const applyTheme = (type: string) => {
    currentTheme = type;
    document.documentElement.dataset.theme = type;
    try {
      localStorage.setItem(STORE_KEY, type);
      localStorage.setItem(EXPIRE_KEY, String(Date.now() + EXPIRE));
    } catch {
      /* localStorage 不可用时忽略 */
    }
    syncThemePanel(type);
    window.dispatchEvent(new CustomEvent('theme:changed', { detail: type }));
  };

  /*
   * ClientRouter 换页时会用新页面的属性重置 <html>（实测 data-theme 与 class 都会被清掉），
   * 所以交换完成后要立刻补回 —— 否则每一页都会闪一下 global.css 里的兜底默认主题，
   * 图片渐显的 .js 开关也会失效。这是最早可用的时机（早于 astro:page-load）。
   */
  document.addEventListener('astro:after-swap', () => {
    document.documentElement.classList.add('js');
    if (currentTheme) document.documentElement.dataset.theme = currentTheme;
  });

  window.addEventListener('theme:select', (event) => {
    const type = (event as CustomEvent<string>).detail;
    if (type) applyTheme(type);
  });

  /*
   * 正文图片渐显
   * 图注（figure/figcaption）与 loading/decoding 已在构建期由 hast 插件生成，
   * 这里只用一个捕获型监听器统一处理「图片解码完成 → 加 .loaded」。
   * （load/error 不冒泡，故必须用捕获阶段。）
   */
  document.addEventListener(
    'load',
    (event) => {
      if (event.target instanceof HTMLImageElement) event.target.classList.add('loaded');
    },
    true,
  );
  document.addEventListener(
    'error',
    (event) => {
      // 加载失败时也显示出来（保持 opacity:1），避免图片永久不可见
      if (event.target instanceof HTMLImageElement) event.target.classList.add('loaded');
    },
    true,
  );

  /* ---------- 正文图片灯箱 ----------
   * <dialog id="photo-lightbox"> 是构建期输出的静态标记，这里只挂一个委托监听器。 */
  document.addEventListener('click', (event) => {
    const img = (event.target as HTMLElement).closest<HTMLImageElement>('.prose img');
    if (!img) return;
    const dialog = document.getElementById('photo-lightbox');
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.querySelector('img')?.setAttribute('src', img.currentSrc || img.src);
    const caption = dialog.querySelector('.photo-caption');
    if (caption) caption.textContent = img.alt ? `◭ ${img.alt}` : '';
    dialog.showModal();
  });

  /* 点击灯箱任意区域（大图 / 图注 / 背景）关闭 —— 对应样式里的 cursor-zoom-out；
   * 旧站 react-photo-view 的「点击遮罩关闭」等价物。dialog 内的 img 不在 .prose 内，
   * 不会误触上面的打开逻辑；ESC 关闭是 showModal 的原生行为，无需额外处理。 */
  document.addEventListener('click', (event) => {
    const dialog = (event.target as HTMLElement).closest('#photo-lightbox');
    if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
  });

  /* ---------- 导航激活态（Side/Header 被 transition:persist 保留后，激活类需在换页后手动更新） ---------- */
  const updateActiveNav = () => {
    const path = location.pathname.endsWith('/') ? location.pathname.slice(0, -1) : location.pathname;
    document.querySelectorAll('.nav a[href]').forEach((a) => {
      const href = a.getAttribute('href') ?? '';
      // 占位社交链接（twitter/telegram/music，config 里为空串）在旧站从不参与激活态；
      // 若参与，首页 pathname 归一化后也是空串，会把它们误标成主题色
      if (!href) {
        a.classList.remove('active');
        return;
      }
      const normalized = href.endsWith('/') ? href.slice(0, -1) : href;
      a.classList.toggle('active', normalized === path);
    });
  };

  /* ---------- 生命周期 ---------- */
  nya();

  /*
   * 列表滚动入场（对应旧站 AOS init{duration:500, easing:'ease', offset:0}，once 默认 false）
   * 判定式逐条对照 aos@2.3.4 源码（t = pageYOffset + innerHeight，e.position = 元素文档 top + offset）：
   *   t > position ⇔ 元素顶边高于视口底边 → 加 .aos-animate 播放入场；
   *   t <= position ⇔ 元素整体落回视口下方 → 移除，之后再次下滚会重播（once:false）；
   *   元素从顶部划出（或被跳过到上方）时 t > position 恒成立 → 类永不撤销，
   *   向上滚回视口时直接以最终态静态展示、不重播。AOS 没有显式的滚动方向判断，
   *   方向语义完全由该判定式隐含，这里同样不需要。
   * 用两个 IntersectionObserver 覆盖「上方 / 视口内 / 下方」三区间的全部迁移：
   *   主观察器（视口）：上方↔视口内、视口内↔下方；
   *   越顶观察器（rootMargin 只保留视口上方的带状区）：补捉「下方↔上方」的直接跳变——
   *   滚动条快拖、换页恢复滚动位置等场景中不相交状态不变、主观察器不派发事件，
   *   该观察器等价于 AOS 每次滚动触发的全量刷新。
   * 初始态/过渡参数由 global.css 的 [data-aos] 规则提供。
   * ClientRouter 换页会替换 body：astro:page-load 里重建观察器（旧节点 disconnect 丢弃）。
   */
  let aosObservers: IntersectionObserver[] = [];
  const setupAos = () => {
    aosObservers.forEach((observer) => observer.disconnect());
    aosObservers = [];
    const items = document.querySelectorAll<HTMLElement>('[data-aos]');
    if (!items.length) return;
    // AOS 判定式的视口坐标等价形式：元素顶边（boundingClientRect.top）高于
    // 视口底边（documentElement.clientHeight）→ 动画态，否则初始态。两个观察器共用同一判定。
    const sync = (entry: IntersectionObserverEntry) => {
      entry.target.classList.toggle(
        'aos-animate',
        entry.boundingClientRect.top < document.documentElement.clientHeight,
      );
    };
    const main = new IntersectionObserver((entries) => entries.forEach(sync), { threshold: 0 });
    // 顶边外扩 99999px、底边内收一个视口高（-100%）：观察区 ≈ 视口上方整条带
    const past = new IntersectionObserver((entries) => entries.forEach(sync), {
      rootMargin: '99999px 0px -100% 0px',
    });
    items.forEach((item) => {
      main.observe(item);
      past.observe(item);
    });
    aosObservers = [main, past];
  };

  document.addEventListener('astro:page-load', () => {
    updateActiveNav();
    if (currentTheme) syncThemePanel(currentTheme);
    setupAos();
  });

  // 首屏：面板高亮与说明链接需要跟 head 内联脚本定下的主题对齐
  const boot = () => {
    if (currentTheme) syncThemePanel(currentTheme);
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>

<style is:global>
  @reference "../styles/global.css";

  /* 正文图片灯箱 */
  dialog#photo-lightbox {
    @apply m-auto max-w-[92vw] cursor-zoom-out border-0 bg-transparent p-0 text-center;
    max-height: 92vh;
  }
  dialog#photo-lightbox::backdrop {
    background-color: var(--background-color);
    opacity: 1;
  }
  dialog#photo-lightbox img {
    @apply mx-auto max-h-[86vh] max-w-full rounded shadow-md;
  }
  dialog#photo-lightbox .photo-caption {
    @apply mt-3 text-sm italic;
    color: var(--font-color);
  }
</style>
